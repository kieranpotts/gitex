#!/bin/env sh
set -eu

#
# git-orphan - Create an orphaned branch, with no parents, and switch to it.
#
# If the new branch name is not inputted, the user will be prompted for it.
#
# By default, the files of the previously checked-out branch, plus any working
# changes, including untracked files, are carried over to the new branch and
# staged, ready for its first commit. If the `--fresh` option is provided, the
# index and working tree are cleared instead, including untracked files. Ignored
# files are kept. If there are uncommitted changes or untracked files, the user
# is prompted to confirm before they are deleted – careful, you may lose
# unsaved work-in-progress.
#
# This is useful to start a fresh trunk that is not based on any previous
# work. You might use this, for example, to create a `gh-pages` branch as
# a build target, but which is otherwise unconnected to the history of
# the source branches.
#
# Note: unlike the branching aliases, the new branch cannot be immediately
# synced with the upstream reference repository. That's because, until there is
# at least one commit in the orphaned branch's history, there is no HEAD
# reference.
#
# Usage:
#   $ git orphan [<branch>] [--fresh] [--no-color]
#
# Options:
#   --fresh     Clear the index and working tree, except ignored files
#   --no-color  Disable colored output
#   -h, --help  Show usage instructions
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

_print_help() {
  cat <<EOF
Usage: git orphan [<branch>] [--fresh] [--no-color]

Create a new branch with no parent commits, and switch to it.

Options:
  --fresh     Clear the index and working tree, except ignored files.
              Prompts for confirmation if there are uncommitted changes
              or untracked files.
  --no-color  Disable colored output.
  --help, -h  Show usage instructions.

Examples:
  $ git orphan gh-pages
  $ git orphan gh-pages --fresh
EOF
}

main() {

  # Parse options.
  branch=""
  fresh=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --fresh)
        fresh=true
        shift
        ;;
      --no-color)
        disable_color
        shift
        ;;
      -h|--help)
        _print_help
        return 0
        ;;
      -*)
        print_error "Unknown option '$1'."
        print_hint "Try 'git orphan --help' for more information."
        return 1
        ;;
      *)
        if [ -z "${branch}" ]; then
          branch="$1"
        else
          print_error "Unexpected argument '$1'."
          print_hint "Try 'git orphan --help' for more information."
          return 1
        fi
        shift
        ;;
    esac
  done

  # Must be run inside a working tree.
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    print_error "Not inside a Git working tree."
    return 1
  fi

  # Prompt for branch name if not provided.
  if [ -z "${branch}" ]; then
    print_prompt "Branch name:"
    read -r branch || true
  fi

  # Validate the branch name.
  if [ -z "${branch}" ]; then
    print_error "Branch name cannot be empty."
    return 1
  fi

  if ! git check-ref-format --branch "${branch}" >/dev/null 2>&1; then
    print_error "'${branch}' is not a valid branch name."
    return 1
  fi

  if git show-ref --verify --quiet "refs/heads/${branch}"; then
    print_error "Branch '${branch}' already exists."
    return 1
  fi

  # Work from the root of the working tree, so that `--fresh` clears all of
  # it, not just the current subdirectory.
  cd "$(git rev-parse --show-toplevel)"

  # Before clearing the working tree, ask the user to confirm the deletion of
  # any staged, unstaged, or untracked changes.
  if [ "${fresh}" = true ] && [ -n "$(git status --porcelain --untracked-files=normal)" ]; then
    print_warning "--fresh will delete these uncommitted changes and untracked files."
    git status --short --untracked-files=normal
    print_prompt "Delete them and continue? [y/N]"
    answer=""
    read -r answer || true
    case "${answer}" in
      y|Y|yes|Yes|YES) ;;
      *)
        print_info "Aborted. Nothing was changed."
        return 1
        ;;
    esac
  fi

  # Create the orphan branch. `git checkout --orphan` creates a branch with no
  # history, and keeps all the files of the previous branch staged in the index.
  if ! git checkout --quiet --orphan "${branch}"; then
    print_error "Failed to create orphan branch '${branch}'."
    return 1
  fi

  # If the user wants a totally clean slate, clear the index and working tree.
  # Ignored files are kept. Untracked files are cleaned first, while the
  # `.gitignore` files that protect ignored files are still in place.
  # Otherwise, stage all working changes, so that the index holds everything in
  # the working tree, ready for the first commit.
  if [ "${fresh}" = true ]; then
    git clean -f -d -q
    git rm -r -f -q --ignore-unmatch .
  else
    git add --all
  fi

  print_success "Switched to new orphan branch '${branch}'."

  if [ "${fresh}" = false ] && [ -n "$(git ls-files)" ]; then
    print_hint "All files in the working tree are staged, ready for the first commit."
  fi
}

main "$@"
