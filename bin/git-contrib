#!/bin/env sh
set -eu

#
# git-contrib - List all contributors, ordered by their total commit count.
#
# This alias is configured to show email addresses (`--email`) and total
# commit counts (`--summary`). The contributors are ordered by their commit
# count (`--numbered`) – the biggest committers first.
#
# Usage:
#   $ git contrib [--no-color]
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

main() {
  unexpected=""
  has_unexpected=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        ;;
      *)
        if [ "${has_unexpected}" = false ]; then
          unexpected="$1"
          has_unexpected=true
        fi
        ;;
    esac
    shift
  done

  if [ "${has_unexpected}" = true ]; then
    print_error "Unexpected argument '${unexpected}'."
    print_hint "git-contrib accepts no arguments other than --no-color."
    return 1
  fi

  # Check if there are any commits in the repository.
  # If HEAD doesn't exist, the repository has no commits.
  if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
    # No commits - return successfully with no output.
    return 0
  fi

  git shortlog --email --summary --numbered HEAD
}

main "$@"
