#!/bin/env sh
set -eu

#
# git-current - Show the name of the current branch.
#
# See also the `git upstream` alias, which returns the name of the tracked
# upstream branch.
#
# Usage:
#   $ git current [--no-color]
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

main() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        shift
        ;;
      *)
        print_error "Unexpected argument '$1'."
        print_hint "git-current accepts no arguments other than --no-color."
        return 1
        ;;
    esac
  done

  # TODO: Review draft implementation, below.

  # Git < 2.22
  git rev-parse --abbrev-ref HEAD

  # Git >= 2.22
  # git branch --show-current

}

main "$@"
