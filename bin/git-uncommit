#!/bin/sh
set -eu

#
# git-uncommit - Undo the last commit, returning the changes introduced in the
# commit to the staging index, ready to be re-committed.
#
# Combine with `git undo` to fully delete the changes. Running both commands,
# `git uncommit && git undo`, is equivalent to doing `git reset HEAD~1 --hard`.
#
# Usage:
#   $ git uncommit [--no-color]
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

main() {
  unexpected=""
  has_unexpected=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        ;;
      *)
        if [ "${has_unexpected}" = false ]; then
          unexpected="$1"
          has_unexpected=true
        fi
        ;;
    esac
    shift
  done

  if [ "${has_unexpected}" = true ]; then
    print_error "Unexpected argument '${unexpected}'."
    print_hint "git-uncommit accepts no arguments other than --no-color."
    return 1
  fi

  git reset HEAD~1 --soft
}

main "$@"
