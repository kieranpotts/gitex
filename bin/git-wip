#!/bin/sh
set -eu

#
# git-wip - Save work-in-progress.
#
# Creates a commit, with the contents of both the staging index and the working
# directory, and with the specified message suffixed with " - WIP". If no
# comment is provided, the commit message will be "WIP".
#
# Continue where you left off tomorrow with `git resume`.
#
# The purpose of this alias is to allow quick saving and backing up (to a
# remote repository) of work-in-progress. WIP commits are expected to be
# reset and their contents restored to the working tree the next time the
# developer continues to work from the current branch. The `git restore`
# alias provides a shortcut for doing exactly this.
#
# Usage:
#   $ git wip [<msg>] [--no-color]
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

main() {
  unexpected=""
  has_unexpected=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        ;;
      *)
        if [ "${has_unexpected}" = false ]; then
          unexpected="$1"
          has_unexpected=true
        fi
        ;;
    esac
    shift
  done

  if [ "${has_unexpected}" = true ]; then
    print_error "Unexpected argument '${unexpected}'."
    print_hint "git-wip accepts no arguments other than --no-color."
    return 1
  fi

  # TODO: Review draft implementation, below.

  git add --all
  git commit --quiet --message "${1:-WIP}${1+ - WIP}"
}

main "$@"
