#!/bin/sh
set -eu

#
# git-filelog - List all the commits that have changed the specified file.
#
# Usage:
#   $ git filelog [<path>] [--no-color]
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

main() {
  unexpected=""
  has_unexpected=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        ;;
      *)
        if [ "${has_unexpected}" = false ]; then
          unexpected="$1"
          has_unexpected=true
        fi
        ;;
    esac
    shift
  done

  if [ "${has_unexpected}" = true ]; then
    print_error "Unexpected argument '${unexpected}'."
    print_hint "git-filelog accepts no arguments other than --no-color."
    return 1
  fi

  # TODO: Review draft implementation, below.

  file="${1}"

  if [ -z "${file}" ]; then
    print_prompt "File path:"
    read -r file
  fi

  if [ -z "${file}" ]; then
    print_error "File path cannot be empty."
    exit 1
  fi

  git log --graph --pretty=format:'%C(red)%h%C(reset)  %<(60,trunc)%s  %C(green)%<(14)%ar  %C(blue)%an %C(yellow)%d%C(reset)' --abbrev-commit -- "${file}"
}

main "$@"
