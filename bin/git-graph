#!/bin/env sh
set -eu

#
# git-graph - Show a detailed graphical representation of the commit
# history; alternative to `git log`.
#
# Usage:
#   $ git graph [--no-color]
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

main() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        shift
        ;;
      *)
        print_error "Unexpected argument '$1'."
        print_hint "git-graph accepts no arguments other than --no-color."
        return 1
        ;;
    esac
  done

  # TODO: Review draft implementation, below.

  git log --oneline --decorate --graph --all
}

main "$@"
