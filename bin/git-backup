#!/bin/env sh
set -eu

#
# git-backup - Create a backup of the current branch or another
# specified branch.
#
# Usage:
#   $ git backup [<branch>] [--no-color]
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

main() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        shift
        ;;
      *)
        print_error "Unexpected argument '$1'."
        print_hint "git-backup accepts no arguments other than --no-color."
        return 1
        ;;
    esac
  done

  # TODO: Review draft implementation, below.

  branch="${1}"

  # Default to the current branch.
  if [ -z "${branch}" ]; then
    branch=$(git branch --show-current)
  fi

  git branch "backup/${branch}" "${branch}"
  print_info "Created branch 'backup/${branch}'."
}

main "$@"
