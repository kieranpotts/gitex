#!/bin/env sh
set -eu

#
# gitex - Get help with using GitEx.
#
# Usage:
#   $ gitex [--version|-v] [--commands|-c] [--help|-h] [--no-color]
#
# Options:
#   -v, --version   Show installed GitEx version number
#   -c, --commands  List available GitEx aliases
#   -h, --help      Show usage instructions
#   --no-color      Disable colored output
#
# Dependencies: (none)
#

_print_help() {
  cat <<EOF
Usage: gitex [--version|-v] [--commands|-c] [--help|-h] [--no-color]

Get help with using GitEx.

Options:
  --version, -v   Show installed GitEx version number.
  --commands, -c  List available GitEx aliases.
  --help, -h      Show usage instructions.
  --no-color      Disable colored output.

Examples:
  $ git gitex --version
  $ git gitex --commands
  $ git -h
EOF
}

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

_print_version() {
  # Extract version from pyproject.toml.
  version=$(grep '^version = ' "$(dirname "$0")/../pyproject.toml" | sed 's/version = "\(.*\)"/\1/')
  if [ -z "${version}" ]; then
    version="unknown"
  fi
  echo "GitEx v${version}"
}

_print_commands() {
  cat <<EOF

GitEx commands:

  git amend [--no-color]
    Add staged or working changes to last commit.

  git author [<ref>] [--name <name>] [--email <email>] [--no-color]
    Change the author of the last commit, or an earlier specified commit.

  git orphan [<branch>] [--fresh] [--no-color]
    Create a branch with no parent commits, and switch to it.

  git unamend [--no-color]
    Undo the prior 'git amend' operation.

  git uncommit [--no-color]
    Undo the last commit, return the changes to the staging index.

  git whoami [--no-color]
    Show the currently configured Git user.

EOF
}

main() {

  # Parse options. At most one action is allowed, alongside --no-color.
  action=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        ;;
      -v|--version|-c|--commands|-h|--help)
        if [ -n "${action}" ]; then
          print_error "Too many options."
          print_hint "Try 'gitex --help' for more information."
          return 1
        fi
        action="$1"
        ;;
      *)
        print_error "Unknown option '$1'."
        print_hint "Try 'gitex --help' for more information."
        return 1
        ;;
    esac
    shift
  done

  case "${action}" in
    -v|--version)
      _print_version
      ;;
    -c|--commands)
      _print_commands
      ;;
    *)
      # If no action, show help.
      _print_help
      ;;
  esac
}

main "$@"
