#!/bin/env sh
set -eu

#
# git-branches - List all branches by order of last commit.
#
# This is an alternative to `git branch`. It has nicer formatting and the
# ordering is more useful. The most-recently revised branches are at the
# top of the list.
#
# Usage:
#   $ git branches [--no-color]
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

main() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        shift
        ;;
      *)
        print_error "Unexpected argument '$1'."
        print_hint "git-branches accepts no arguments other than --no-color."
        return 1
        ;;
    esac
  done

  # TODO: Review draft implementation, below.

  # Sort by last commit date, newest first.
  git for-each-ref --sort='-authordate:iso8601' --format='  %(color:green)%(authordate:relative)%09%(color:white)%(refname:short)' refs/heads
}

main "$@"
