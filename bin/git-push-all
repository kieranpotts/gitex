#!/bin/sh
set -eu

#
# git-push-all - Push changes in all local branches to their tracked
# branches in the remote repository. Defaults to the "origin" remote
# unless otherwise specified.
#
# Usage:
#   $ git push-all [<remote>] [--no-color]
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

main() {
  unexpected=""
  has_unexpected=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        ;;
      *)
        if [ "${has_unexpected}" = false ]; then
          unexpected="$1"
          has_unexpected=true
        fi
        ;;
    esac
    shift
  done

  if [ "${has_unexpected}" = true ]; then
    print_error "Unexpected argument '${unexpected}'."
    print_hint "git-push-all accepts no arguments other than --no-color."
    return 1
  fi

  # TODO: Review draft implementation, below.

  # Get the name of the remote repository, default to origin.
  remote=${1:-origin}

  # Get the name of the current checked out branch.
  current_branch=$(git rev-parse --abbrev-ref HEAD)

  # Get the names of all local branches except the trunk branch
  branches=$(git branch --format='%(refname:short)')

  # Push each branch.
  for branch in ${branches}; do
    git checkout "${branch}"
    git push "${remote}" "${branch}" --follow-tags --force-with-lease
  done

  # Switch back to the original checked-out branch.
  git checkout "${current_branch}"
}

main "$@"
