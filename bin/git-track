#!/bin/sh
set -eu

#
# git-track - Start tracking one or more new files. This is an alias for
# `git add` and the opposite of the `git untrack` alias.
#
# Options are forwarded.
#
# Usage:
#   $ git track [<path>] [--all|-A] [--no-color]
#
# Examples:
#   # Add all changes in whole working tree.
#   $ git track (--all|-A)
#
#   # Add all changes in current path.
#   $ git track .
#
#   # Add one or more specific files.
#   $ git track path/to/file.ext
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

main() {
  unexpected=""
  has_unexpected=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        ;;
      *)
        if [ "${has_unexpected}" = false ]; then
          unexpected="$1"
          has_unexpected=true
        fi
        ;;
    esac
    shift
  done

  if [ "${has_unexpected}" = true ]; then
    print_error "Unexpected argument '${unexpected}'."
    print_hint "git-track accepts no arguments other than --no-color."
    return 1
  fi

  # TODO: Review draft implementation, below.

  path="${1}"

  if [ -z "${path}" ]; then
    git add --all
  else
    git add "${path}"
  fi
}

main "$@"
