#!/bin/env sh
set -eu

#
# git-versions - List tags prefixed with the lowercase letter "v",
# sorted numerically.
#
# Usage:
#   $ git versions [--no-color]
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

main() {
  unexpected=""
  has_unexpected=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        ;;
      *)
        if [ "${has_unexpected}" = false ]; then
          unexpected="$1"
          has_unexpected=true
        fi
        ;;
    esac
    shift
  done

  if [ "${has_unexpected}" = true ]; then
    print_error "Unexpected argument '${unexpected}'."
    print_hint "git-versions accepts no arguments other than --no-color."
    return 1
  fi

  # TODO: Review draft implementation, below.

  git tag --list --sort=-version:refname v*
}

main "$@"
