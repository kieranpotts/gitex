#!/bin/sh
set -eu

#
# git-author - Change the name and email of the author of the last commit, or
# an earlier specified commit in the checked-out branch's history.
#
# Usage:
#   $ git author [<ref>] [--name <name>] [--email <email>] [--no-color]
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

# Record a usage error, unless an earlier one has already been recorded.
# Usage: _usage_error "<message>"
_usage_error() {
  if [ -z "${usage_error}" ]; then
    usage_error="$1"
  fi
}

main() {

  # Parse options. Report usage errors only once the whole command line has
  # been read, so the order of options doesn't matter. Because the last of
  # two --name or --email values would otherwise win, giving either option
  # twice is an error.
  ref=""
  author_name=""
  author_email=""
  has_name=false
  has_email=false
  usage_error=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --name)
        if [ "${has_name}" = true ]; then
          _usage_error "--name can only be given once."
        fi
        has_name=true
        if [ $# -lt 2 ] || [ -z "${2:-}" ] || [ "${2#--}" != "$2" ]; then
          _usage_error "--name requires a value."
          shift
          continue
        fi
        author_name="$2"
        shift 2
        ;;
      --email)
        if [ "${has_email}" = true ]; then
          _usage_error "--email can only be given once."
        fi
        has_email=true
        if [ $# -lt 2 ] || [ -z "${2:-}" ] || [ "${2#--}" != "$2" ]; then
          _usage_error "--email requires a value."
          shift
          continue
        fi
        author_email="$2"
        shift 2
        ;;
      --no-color)
        disable_color
        shift
        ;;
      -*)
        _usage_error "Unknown option '$1'."
        shift
        ;;
      *)
        if [ -z "${ref}" ]; then
          ref="$1"
        else
          _usage_error "Unexpected option '$1'."
        fi
        shift
        ;;
    esac
  done

  if [ -n "${usage_error}" ]; then
    print_error "${usage_error}"
    return 1
  fi

  # Prompt for author name if not provided.
  if [ -z "${author_name}" ]; then
    print_prompt "Author's name:"
    read -r author_name
    echo ""
  fi

  # Name is required.
  if [ -z "${author_name}" ]; then
    print_error "Name is required."
    exit 1
  fi

  # Prompt for email if not provided.
  if [ -z "${author_email}" ]; then
    print_prompt "Author's email address:"
    read -r author_email
    echo ""
  fi

  # Email is required.
  if [ -z "${author_email}" ]; then
    print_error "Email is required."
    exit 1
  fi

  # Get the name of the current branch.
  branch=$(git branch --show-current)

  # Target revision (defaults to HEAD if not specified).
  rev=$(git rev-parse "${ref:-HEAD}")

  # Check if we're modifying HEAD directly.
  head_rev=$(git rev-parse HEAD)

  if [ "${rev}" = "${head_rev}" ]; then
    # Simple case: modifying the current HEAD commit.
    # No need to checkout or rebase.

    # Amend commit with new author.
    git commit --quiet --amend --author "${author_name} <${author_email}>" --no-edit

    # Output the new commit hash.
    print_info "New commit hash is $(git rev-parse HEAD)."

  else
    # Complex case: modifying an earlier commit.
    # Need to checkout, amend, and rebase.

    # Checkout the target commit. Git repo enters a "detached HEAD" state.
    git checkout --quiet "${rev}"

    # Amend commit with new author.
    git commit --quiet --amend --author "${author_name} <${author_email}>" --no-edit

    # New commit hash.
    new_rev=$(git rev-parse HEAD)
    print_info "New commit hash is ${new_rev}."

    # Switch back to the previous branch then rebase on the new revision.
    git switch --quiet "${branch}"
    git rebase "${new_rev}"
  fi
}

main "$@"
