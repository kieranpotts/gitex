#!/bin/env sh
set -eu

#
# git-ff - Perform a fast-forward merge.
#
# This operation fails if there is divergent work in the current (source) branch
# that is not in the target branch. In this situation, the current branch must
# be rebased on the target branch beforehand.
#
# Usage:
#   $ git ff [<branch>] [--no-color]
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

main() {
  unexpected=""
  has_unexpected=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        ;;
      *)
        if [ "${has_unexpected}" = false ]; then
          unexpected="$1"
          has_unexpected=true
        fi
        ;;
    esac
    shift
  done

  if [ "${has_unexpected}" = true ]; then
    print_error "Unexpected argument '${unexpected}'."
    print_hint "git-ff accepts no arguments other than --no-color."
    return 1
  fi

  # TODO: Review draft implementation, below.

  branch=${1:-main}
  #branch="${1}"

  if [ -z "${branch}" ]; then
    print_prompt "Branch name:"
    read -r branch
  fi

  if [ -z "${branch}" ]; then
    print_error "Branch name cannot be empty."
    exit 1
  fi

  git merge --ff-only "${branch}"
}

main "$@"
