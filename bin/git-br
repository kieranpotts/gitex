#!/bin/sh
set -eu

#
# git-br - Branch from current position, switch to it, and push upstream
# immediately, establishing remote tracking from the start of the branch's
# existence.
#
# If the new branch name is not inputted, the user will be prompted for it.
#
# This operation fails with an error if the branch name is already taken.
#
# Usage:
#   $ git br [<branch>] [--no-color]
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

main() {

  # Parse options. Report usage errors only once the whole command line has
  # been read, so the order of options doesn't matter.
  branch=""
  has_branch=false
  too_many=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        ;;
      *)
        if [ "${has_branch}" = true ]; then
          too_many=true
        else
          branch="$1"
          has_branch=true
        fi
        ;;
    esac
    shift
  done

  if [ "${too_many}" = true ]; then
    print_error "git-br accepts at most one argument, the branch name."
    return 1
  fi

  # No argument provided, prompt for branch name.
  if [ "${has_branch}" = false ]; then
    print_prompt "Enter branch name:"
    read -r branch
  fi

  # Validate branch name is not empty.
  if [ -z "${branch}" ]; then
    print_error "Branch name cannot be empty."
    return 1
  fi

  # Create and checkout the new branch.
  git branch "${branch}" && git checkout "${branch}"

  # Determine the remote name to use (customizable via environment variable).
  remote="${GITEX_DEFAULT_REMOTE_NAME:-origin}"

  # Push to remote and set up tracking.
  git push --set-upstream "${remote}" HEAD
}

main "$@"
