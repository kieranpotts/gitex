#!/bin/env sh
set -eu

#
# git-unignore - Stop ignoring changes made to a file.
#
# This command is the opposite of `git ignore`. Use `git ignored` to see a list
# of file paths that are currently ignored, and which can therefore be
# unignored.
#
# Usage:
#   $ git unignore <path> [--no-color]
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

main() {
  unexpected=""
  has_unexpected=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        ;;
      *)
        if [ "${has_unexpected}" = false ]; then
          unexpected="$1"
          has_unexpected=true
        fi
        ;;
    esac
    shift
  done

  if [ "${has_unexpected}" = true ]; then
    print_error "Unexpected argument '${unexpected}'."
    print_hint "git-unignore accepts no arguments other than --no-color."
    return 1
  fi

  # TODO: Review draft implementation, below.

  file="${1}"

  if [ -z "${file}" ]; then
    print_error "A file path is required."
    exit 1
  fi

  # Reference:
  # https://mirrors.edge.kernel.org/pub/software/scm/git/docs/git-update-index.html
  git update-index --no-assume-unchanged "${file}"
}

main "$@"
