#!/bin/env sh
set -eu

#
# git-stashed - Show the current number of entries in the stash.
#
# Usage:
#   $ git stashed [--no-color]
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

main() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        shift
        ;;
      *)
        print_error "Unexpected argument '$1'."
        print_hint "git-stashed accepts no arguments other than --no-color."
        return 1
        ;;
    esac
  done

  # TODO: Review draft implementation, below.

  git status --show-stash
}

main "$@"
