#!/bin/env sh
set -eu

#
# git-download - Improved `git fetch`: download and prune local objects,
# tags, and branches to match all remotes.
#
# This command also removes any refs from the local repository that no longer
# exist in any remote, including tags. Careful, any tags newly-created in the
# downstream repository will be deleted unless they have been already pushed
# upstream. Local branches will not be deleted, however – only references to
# branches in the upstream repository are deleted.
#
# Usage:
#   $ git download [--no-color]
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

main() {
  unexpected=""
  has_unexpected=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        ;;
      *)
        if [ "${has_unexpected}" = false ]; then
          unexpected="$1"
          has_unexpected=true
        fi
        ;;
    esac
    shift
  done

  if [ "${has_unexpected}" = true ]; then
    print_error "Unexpected argument '${unexpected}'."
    print_hint "git-download accepts no arguments other than --no-color."
    return 1
  fi

  # TODO: Review draft implementation, below.

  git fetch --all --tags --prune --prune-tags

  # TODO: Extend this to fetch all branches, too
  # https://stackoverflow.com/questions/18891794/git-pull-all-branches-from-remote-repository
}

main "$@"
