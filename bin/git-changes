#!/bin/env sh
set -eu

#
# git-changes - Show the changes introduced in a specified commit, or
# introduced to the working directory (including untracked files) plus
# staging index since the last commit.
#
# See also `git-staged`, which lists only staged changes, and `git-working`,
# which lists only unstaged/working changes.
#
# If a commit hash is provided as an input option, this command will instead
# list all the files that were committed with changes in the given commit. See
# also `git-last`, which is a shortcut for showing the changes introduced in
# the last commit.
#
# Usage:
#   $ git changes [<ref>] [--no-color]
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

main() {
  unexpected=""
  has_unexpected=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        ;;
      *)
        if [ "${has_unexpected}" = false ]; then
          unexpected="$1"
          has_unexpected=true
        fi
        ;;
    esac
    shift
  done

  if [ "${has_unexpected}" = true ]; then
    print_error "Unexpected argument '${unexpected}'."
    print_hint "git-changes accepts no arguments other than --no-color."
    return 1
  fi

  # TODO: Review draft implementation, below.

  if [ -z "${1}" ]; then
    git diff --stat HEAD
  else
    # shellcheck disable=SC2140
    git diff --stat "$1^".."$1"
  fi
}

main "$@"
