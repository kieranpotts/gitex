#!/bin/env sh
set -eu

#
# git-unstage - Alias for `git reset --mixed HEAD`, which just
# removes everything from the staging index, returning those
# changes to the working directory.
#
# Usage:
#   $ git unstage [--no-color]
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

main() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        shift
        ;;
      *)
        print_error "Unexpected argument '$1'."
        print_hint "git-unstage accepts no arguments other than --no-color."
        return 1
        ;;
    esac
  done

  # TODO: Review draft implementation, below.

  git reset
}

main "$@"
