#!/bin/sh
set -eu

#
# git-state - Concise view of `git status`.
#
# Provides a short-format view of the working tree's current state, with
# branch and tracking information added.
#
# Usage:
#   $ git state [--no-color]
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

main() {
  unexpected=""
  has_unexpected=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        ;;
      *)
        if [ "${has_unexpected}" = false ]; then
          unexpected="$1"
          has_unexpected=true
        fi
        ;;
    esac
    shift
  done

  if [ "${has_unexpected}" = true ]; then
    print_error "Unexpected argument '${unexpected}'."
    print_hint "git-state accepts no arguments other than --no-color."
    return 1
  fi

  # TODO: Review draft implementation, below.

  git status --short --branch
}

main "$@"
