#!/bin/env sh
set -eu

#
# git-whoami - Show the currently configured Git user.
#
# Local repository and global configuration are considered.
# If no user is configured, "[not set]" is shown.
#
# Usage:
#   $ git whoami [--no-color]
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

main() {
  unexpected=""
  has_unexpected=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        ;;
      *)
        if [ "${has_unexpected}" = false ]; then
          unexpected="$1"
          has_unexpected=true
        fi
        ;;
    esac
    shift
  done

  if [ "${has_unexpected}" = true ]; then
    print_error "Unexpected argument '${unexpected}'."
    print_hint "git-whoami accepts no arguments other than --no-color."
    return 1
  fi

  name=$(git config --get user.name 2>/dev/null)
  email=$(git config --get user.email 2>/dev/null)

  if [ -z "${name}" ]; then
    name="[not set]"
  fi

  if [ -z "${email}" ]; then
    email="[not set]"
  fi

  echo "name:  ${name}"
  echo "email: ${email}"
}

main "$@"
