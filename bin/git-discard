#!/bin/sh
set -eu

#
# git-discard - Discard working changes to one or more files. Changes
# made will be lost indefinitely.
#
# This is equivalent of the undo operation in VS Code's built-in Git GUI.
#
# Multiple file paths may be inputted, but additional options are not accepted
# (they are disabled by the double hyphen `--` which marks the start of the
# file list).
#
# This is a destructive operation. If you accidentally discard working
# changes, they cannot be retrieved.
#
# Usage:
#   $ git discard <path>... [--no-color]
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

main() {
  unexpected=""
  has_unexpected=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        ;;
      *)
        if [ "${has_unexpected}" = false ]; then
          unexpected="$1"
          has_unexpected=true
        fi
        ;;
    esac
    shift
  done

  if [ "${has_unexpected}" = true ]; then
    print_error "Unexpected argument '${unexpected}'."
    print_hint "git-discard accepts no arguments other than --no-color."
    return 1
  fi

  # TODO: Review draft implementation, below.

  git checkout -- "$@"

  # TODO: Use same SAVEPOINT strategy as for `git undo`?

  if [ -z "${1}" ]; then
    print_error "At least one file path is required."
    exit 1
  fi

  # Bash-compatible code, with string indexing that allows additional options
  # to be passed on to the `git checkout` command. This allows multiple files
  # to be inputted in a single command.
  #git checkout -q -- ${@:1}

  # POSIX-compatible code, without string indexing. This code only passes the
  # first option to the `git checkout` command, which means only one file
  # can be processed at a time.
  git checkout -q -- "${1}"
}

main "$@"
