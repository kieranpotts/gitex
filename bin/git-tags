#!/bin/sh
set -eu

#
# git-tags - List all tags, sorted by commit date.
#
# Use `git download` to download all tags, as well as branches, from the
# upstream repository.
#
# Usage:
#   $ git tags [--no-color]
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

main() {
  unexpected=""
  has_unexpected=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        ;;
      *)
        if [ "${has_unexpected}" = false ]; then
          unexpected="$1"
          has_unexpected=true
        fi
        ;;
    esac
    shift
  done

  if [ "${has_unexpected}" = true ]; then
    print_error "Unexpected argument '${unexpected}'."
    print_hint "git-tags accepts no arguments other than --no-color."
    return 1
  fi

  # TODO: Review draft implementation, below.

  git tag --list --sort=committerdate
}

main "$@"
