#!/bin/env sh
set -eu

#
# git-tracking - Same as `git branches` but also shows the names of
# the tracked upstream branches.
#
# Use `git upstream` to get only the name of the upstream branch that is
# tracked by the current checked-out downstream branch.
#
# Usage:
#   $ git tracking [--no-color]
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

main() {
  unexpected=""
  has_unexpected=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        ;;
      *)
        if [ "${has_unexpected}" = false ]; then
          unexpected="$1"
          has_unexpected=true
        fi
        ;;
    esac
    shift
  done

  if [ "${has_unexpected}" = true ]; then
    print_error "Unexpected argument '${unexpected}'."
    print_hint "git-tracking accepts no arguments other than --no-color."
    return 1
  fi

  # TODO: Review draft implementation, below.

  # Sort by last commit date, newest first.
  git for-each-ref --sort='-authordate:iso8601' --format='  %(color:green)%(authordate:relative)%09%(color:white)%(refname:short) %(color:cyan)➔ %(upstream:short)' refs/heads
}

main "$@"
