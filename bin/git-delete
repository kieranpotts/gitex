#!/bin/env sh
set -eu

#
# git-delete - Delete a local branch, but only if it's changes have
# been merged elsewhere.
#
# This is a safe delete operation. It will not, by default, force-delete local
# branches, but instead prompt for user confirmation if the branch contains
# work that is not merged elsewhere. Upstream branches are not deleted.
#
# Usage:
#   $ git delete [<branch>] [--no-color]
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

main() {
  unexpected=""
  has_unexpected=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        ;;
      *)
        if [ "${has_unexpected}" = false ]; then
          unexpected="$1"
          has_unexpected=true
        fi
        ;;
    esac
    shift
  done

  if [ "${has_unexpected}" = true ]; then
    print_error "Unexpected argument '${unexpected}'."
    print_hint "git-delete accepts no arguments other than --no-color."
    return 1
  fi

  # TODO: Review draft implementation, below.

  # Was the target branch provided as a option?
  branch="${1}"

  # If not, let the user select from a list.
  if [ -z "${branch}" ]; then

    branches=$(git for-each-ref --sort='-authordate:iso8601' --format='%(refname)' refs/heads/)

    # TODO:
    # Remove main, master and current branch from list of available branches to delete.

    set -- "${branches}"
    i=0
    for branch_name
    do
      # Remove refs/heads/ from start of branch name
      branch_name=$(echo "${branch_name}" | sed 's|refs/heads/||')
      printf "%s - %s\n" "${i}" "${branch_name}"
      i=$((i + 1))
    done

    print_prompt "Number of the branch to delete:"
    read -r index

    if [ -z "${index}" ]; then
      print_error "No branch selected."
      exit 1
    fi

    # Remove refs/heads/ from start of branch name
    branch=${branches[index]:11}

  fi

  # Attempt to delete the local branch. Silence non-error output and capture
  # errors. Respond to errors by asking the user if they want to try a force-delete.
  git branch --quiet --delete "${branch}" 2> /dev/null
  EXIT_CODE_1=$?

  if [ ${EXIT_CODE_1} -eq 1 ]; then

    print_warning "Failed to delete branch '${branch}'. It may contain commits that are not merged elsewhere."
    print_hint "Force-deleting it risks permanently losing commits that don't exist in the history of any other local branch."
    print_prompt "Force delete? [y/N]"
    read -r choice

    case "${choice}" in
      y|Y )
        # Hide all errors from these commands. Basically, if these fail, the
        # branch almost certainly does not exist or is somehow protected from
        # deletion (for example, it is the current checked out branch).
        git branch --quiet --delete --force "${branch}" 2> /dev/null
        print_success "Deleted branch '${branch}'."
        ;;

      * )
        print_info "Aborted. Nothing was changed."
        ;;
    esac

  else
    print_success "Deleted branch '${branch}'."
  fi
}

main "$@"
