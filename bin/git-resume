#!/bin/env sh
set -eu

#
# git-resume - Resume work-in-progress committed via the last
# `git wip` operation.
#
# This operation will succeed only if the message of the last commit is "wip"
# or starts with "wip:". This is intended to be used in conjunction with the
# `git wip` command.
#
# Usage:
#   $ git resume [--no-color]
#
# Dependencies: (none)
#

# shellcheck source=../lib/print.sh
. "$(dirname "$0")/../lib/print.sh"

main() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-color)
        disable_color
        shift
        ;;
      *)
        print_error "Unexpected argument '$1'."
        print_hint "git-resume accepts no arguments other than --no-color."
        return 1
        ;;
    esac
  done

  # TODO: Review draft implementation, below.

  # Get message of last commit.
  msg=$(git show -s --format=%B HEAD)

  # Bash-specific way to get the last 6 characters of a string.
  #if [ "${msg}" = "wip" ] || [ "${msg: -6}" = " - wip" ]; then

  msg_end=$(echo "${msg}" | tail -c 7)
  if [ "${msg}" = "wip" ] || [ "${msg_end}" = " - wip" ]; then
    git reset HEAD~1 --mixed
  else
    print_error "The last commit is not a work-in-progress commit."
    exit 1
  fi
}

main "$@"
