#!/usr/bin/env bash

#
# Runs all static and runtime tests.
#

# Exit immediately on error (-e), treat unset variables as errors (-u), and
# propagate failures through pipelines (-o pipefail).
set -euo pipefail

# Resolve the project root (parent of the run/ directory) and change into it.
# This ensures the script behaves the same regardless of where it's invoked
# from.
cd "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.."

echo "Running ShellCheck..."
shellcheck --severity=style bin/* lib/*

echo ""
echo "Running Ruff linter..."
poetry run ruff check test/

echo ""
echo "Running pytest..."
poetry run pytest -v
